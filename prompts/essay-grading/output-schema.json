{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "estimatedScore": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "strengths": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "weaknesses": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "pointsCovered": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "pointsMissing": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "structureAnalysis": {
      "type": "string",
      "maxLength": 8000
    },
    "languageAnalysis": {
      "type": "string",
      "maxLength": 8000
    },
    "annotations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffset": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "selectedText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "category": {
            "type": "string",
            "enum": [
              "CONTENT",
              "POINT",
              "LOGIC",
              "STRUCTURE",
              "LANGUAGE",
              "WORDING",
              "MATERIAL",
              "ARGUMENT",
              "POLICY",
              "TASK_REQUIREMENT",
              "OTHER"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "suggestion": {
            "default": "",
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "startOffset",
          "endOffset",
          "selectedText",
          "category",
          "severity",
          "comment",
          "suggestion"
        ],
        "additionalProperties": false
      }
    },
    "suggestions": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "pointAssessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pointId", "label", "status", "awarded", "evidence", "reason"],
        "properties": {
          "pointId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["HIT", "PARTIAL", "MISS"]
          },
          "awarded": {
            "type": "number",
            "minimum": 0
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "estimatedScore",
    "confidence",
    "summary",
    "strengths",
    "weaknesses",
    "pointsCovered",
    "pointsMissing",
    "structureAnalysis",
    "languageAnalysis",
    "annotations",
    "suggestions",
    "pointAssessments"
  ],
  "additionalProperties": false
}
