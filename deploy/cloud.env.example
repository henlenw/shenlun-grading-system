# Copy values into the cloud container's secret environment settings. Never put these in the mini program.
NODE_ENV=production
APP_URL=https://REPLACE_WITH_REAL_PUBLIC_HOST
PORT=8080
HOST=127.0.0.1
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
STORAGE_PROVIDER=s3
S3_REGION=ap-shanghai
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
S3_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET
S3_FORCE_PATH_STYLE=false
# Alternative: STORAGE_PROVIDER=cloudbase-pg; omit the S3 values above.
# Free shared PostgreSQL: DATABASE_PROVIDER=cloudbase-http and STORAGE_PROVIDER=cloudbase-pg.
# First apply the versioned CloudBase SQL migration. DATABASE_URL is not used in HTTP mode.
# Keep API Key only in the server's secret settings, never in browser or mini-program code.
CLOUDBASE_ENV_ID=
CLOUDBASE_STORAGE_BUCKET=submissions
CLOUDBASE_API_KEY=
STORAGE_PATH=/data/storage
AI_PROVIDER=manual
OCR_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OCR_URL=http://127.0.0.1:8001
OCR_TOKEN=REPLACE_IF_OCR_ENABLED
WECHAT_APPID=
WECHAT_APPSECRET=
BUSINESS_UTC_OFFSET_MINUTES=480
AUDIT_RETENTION_DAYS=180
FILE_RETENTION_DAYS=0
