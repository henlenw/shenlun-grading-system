NODE_ENV=development
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
HOST="127.0.0.1"
PORT=4000
SESSION_SECRET="CHANGE_ME_WITH_32_RANDOM_BYTES"
BOOTSTRAP_TOKEN="CHANGE_ME_WITH_32_RANDOM_BYTES"
WECHAT_APPID=""
WECHAT_APPSECRET=""
STORAGE_PATH="./storage"
AI_PROVIDER="manual"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"
OCR_ENABLED="false"
OCR_URL="http://127.0.0.1:8001"
OCR_TOKEN="CHANGE_ME_WITH_32_RANDOM_BYTES"

# Teacher daily queue uses China Standard Time; change offset for another fixed business zone.
BUSINESS_UTC_OFFSET_MINUTES=480
AUDIT_RETENTION_DAYS=180
# AI_PROVIDER: ollama (local), manual/disabled, remote-worker (outbound local worker).

DATABASE_PROVIDER=sqlite
STORAGE_PROVIDER=local
FILE_RETENTION_DAYS=0
REMOTE_WORKER_TOKEN=
WORKER_API_URL=
WORKER_TOKEN=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional private storage provider: cloudbase-pg. Server credentials only.
# Free shared PostgreSQL additionally uses DATABASE_PROVIDER=cloudbase-http.
# Generate its client and apply the SQL RPC migration; see docs/CLOUDBASE-DATA-LAYER.md.
CLOUDBASE_ENV_ID=
CLOUDBASE_STORAGE_BUCKET=submissions
CLOUDBASE_API_KEY=
