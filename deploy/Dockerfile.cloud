FROM node:24-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
FROM base AS build
RUN npm install -g pnpm@10.28.2
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 DATABASE_PROVIDER=postgres DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY teacher-admin/package.json teacher-admin/package.json
RUN pnpm install --frozen-lockfile
COPY . .
ENV API_PROXY_URL=http://127.0.0.1:4000
RUN node scripts/database-schema.mjs && pnpm db:generate && node scripts/generate-cloudbase-client.mjs && pnpm build
FROM base AS runtime
WORKDIR /app
# Keep the runtime independent of the builder's package store and download caches.
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /data/storage && chown -R node:node /data
USER node
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOST=127.0.0.1 PORT=8080 STORAGE_PATH=/data/storage AI_PROVIDER=manual STORAGE_PROVIDER=cloudbase-pg
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","scripts/start-cloud.mjs"]
