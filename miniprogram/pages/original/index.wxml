<view class="page"><view class="eyebrow">考吧167 / 已发布批注</view><view class="title">老师原稿批注</view><view wx:if="{{error}}" class="error" bindtap="loadPage">{{error}} · 点击重试</view><view class="file-tabs"><button wx:for="{{files}}" wx:key="id" class="secondary small {{fileIndex===index?'selected-file':''}}" data-index="{{index}}" bindtap="selectFile">{{item.fileName}}</button></view><view class="row"><button class="secondary small" disabled="{{page<=1 || loading}}" bindtap="prev">上一页</button><text>{{page}} / {{total}}</text><button class="secondary small" disabled="{{page>=total || loading}}" bindtap="next">下一页</button><button class="secondary small" bindtap="zoom">{{zoomed?'还原':'放大'}}</button></view><view wx:if="{{loading}}" class="notice">正在读取原稿…</view><scroll-view scroll-x scroll-y style="height:65vh;margin-top:24rpx;background:#e4eaf1"><canvas canvas-id="original" id="original" style="width:{{canvasWidth}}px;height:{{canvasHeight}}px"/></scroll-view><view wx:for="{{comments}}" wx:key="id" class="annotation"><view class="prose">{{item.content || '请查看图中标注的位置'}}</view></view><view class="notice">这里仅展示老师已发布的正式批注。原始文件保持不变。</view></view>