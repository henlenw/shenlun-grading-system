<view class="page"><view class="eyebrow">我的 / GROWTH</view><view class="title">{{name}}</view><view class="subtitle">每一次复盘，都在积蓄力量。</view><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view><view class="grid" style="margin-top:30rpx"><view class="metric"><view class="number">{{stats.submissionCount || 0}}</view><view class="muted">提交次数</view></view><view class="metric"><view class="number">{{best}}</view><view class="muted">最高分</view></view><view class="metric"><view class="number">{{rate}}%</view><view class="muted">三练完成率</view></view></view><view class="card"><view class="card-title">我的成绩趋势</view><view class="muted">最近五次平均分 {{average}} · 图示为得分比例</view><canvas canvas-id="trend" id="trend"/><view wx:if="{{!stats.scores.length}}" class="muted">老师发布首份成绩后，将展示成长记录。</view></view><view class="card link" bindtap="redeem">兑换试卷 →</view><view wx:if="{{serviceType}}" class="notice">我的教学服务：{{serviceType}}</view><view wx:if="{{courses.length}}" class="section">我的课程权益</view><view wx:for="{{courses}}" wx:key="id" class="card"><view class="card-title">{{item.name}}</view><view class="muted">{{item.delivery}}</view></view><view class="section">学习记录</view><view wx:for="{{stats.scores}}" wx:key="index" class="card row" data-id="{{item.assignmentId}}" bindtap="open"><view>{{item.title}}</view><view class="link">{{item.score}} / {{item.maxScore}} 分 →</view></view><view class="card link" bindtap="privacy">隐私与账号说明 →</view><view class="card link" bindtap="account">网页账号 →</view><button class="secondary" bindtap="logout">退出登录</button></view>