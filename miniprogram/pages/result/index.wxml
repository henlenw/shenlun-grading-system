<view class="page"><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view><block wx:if="{{a}}"><view class="eyebrow">第 {{a.attemptNo}} 次作答 · {{a.statusText}}</view><view class="title">{{assignment.title}}</view><block wx:if="{{a.finalGrade}}"><view class="card"><view class="muted">老师最终评分</view><view class="score">{{a.finalGrade.finalScore}}<text class="muted"> / {{assignment.question.maxScore}} 分</text></view><view class="divider"></view><view class="card-title">教师总评</view><view class="prose">{{a.finalGrade.summary}}</view></view><view class="card"><view wx:if="{{a.finalGrade.strengths}}"><view class="card-title">得分点</view><view class="prose">{{a.finalGrade.strengths}}</view></view><view wx:if="{{a.finalGrade.weaknesses}}"><view class="label">主要问题 / 扣分点</view><view class="prose">{{a.finalGrade.weaknesses}}</view></view><view wx:if="{{a.finalGrade.nextFocus}}"><view class="label">下一次重点</view><view class="prose">{{a.finalGrade.nextFocus}}</view></view><view wx:if="{{a.finalGrade.recommendedResources}}"><view class="label">推荐资料</view><view class="prose">{{a.finalGrade.recommendedResources}}</view></view></view></block><view wx:else class="notice">当前状态：{{a.statusText}}。老师发布批改后，你会在这里看到成绩与反馈。</view><view wx:if="{{a.revisionReason}}" class="card"><view class="card-title">重做要求</view><view class="prose">{{a.revisionReason}}
{{a.revisionRequirements}}</view><view class="muted">截止 {{a.revisionDueText}}</view></view><view wx:if="{{hasOriginal}}" class="card link" bindtap="original">查看老师在原稿上的批注 →</view><view class="section">我的原文</view><view class="card prose"><text wx:for="{{segments}}" wx:key="index" class="{{item.highlight?'highlight':''}}">{{item.text}}</text><view wx:if="{{!segments.length}}" class="muted">本次作答以附件提交</view></view><view wx:for="{{a.attachments}}" wx:key="id" class="card link" data-index="{{index}}" bindtap="file">查看附件：{{item.fileName}}</view><block wx:if="{{a.finalGrade.annotations.length}}"><view class="section">老师批注</view><view wx:for="{{a.finalGrade.annotations}}" wx:key="index" class="annotation"><view class="muted">「{{item.selectedText}}」</view><view class="prose">{{item.comment}}</view><view wx:if="{{item.suggestion}}" class="prose">修改建议：{{item.suggestion}}</view></view></block><button wx:if="{{canWrite}}" bindtap="redo">{{a.status==='DRAFT'?'继续作答':'再次作答'}}</button></block></view>