<view class="page"><view class="brand-row"><image class="brand-logo" src="/assets/brand/logo-icon.png" mode="aspectFit"/><view><view class="eyebrow">考吧167 · 申论训练</view><view class="title">你好，{{name}}</view></view></view><view class="subtitle">独立作答，对照反馈，看见进步。</view><view class="grid"><view class="metric" bindtap="all"><view class="number">{{total}}</view><view class="muted">已授权题目</view></view><view class="metric"><view class="number">{{training}}</view><view class="muted">训练中</view></view><view class="metric"><view class="number">{{unread}}</view><view class="muted">未读通知</view></view></view><view class="hero" bindtap="redeem"><view class="hero-title">兑换试卷</view><view class="muted">输入老师提供的兑换码，开启新一轮训练 →</view></view><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view><view class="section"><text>继续训练</text><text class="link" bindtap="all">全部题目 →</text></view><view wx:if="{{loading}}" class="muted">正在更新…</view><view wx:for="{{pending}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row"><view class="card-title">{{item.title}}</view><text class="badge">{{item.statusText}}</text></view><view class="muted">{{item.question.category}} · {{item.roundText}}</view><view wx:if="{{item.progressText}}" class="progress-line">{{item.progressText}}</view></view><view wx:if="{{!pending.length && !loading}}" class="empty">目前没有待作答题目
老师发布结果后可继续下一轮</view><block wx:if="{{latest}}"><view class="section">老师最新反馈</view><view class="card" bindtap="open" data-id="{{latest.id}}"><view class="card-title">{{latest.title}}</view><view class="row"><text class="score">{{latest.latest.finalGrade.finalScore}}</text><text class="link">查看反馈 →</text></view><view class="prose">{{latest.latest.finalGrade.summary}}</view></view></block><block wx:if="{{notifications.length}}"><view class="section"><text>老师通知</text><text class="link" bindtap="read">标为已读</text></view><view wx:for="{{notifications}}" wx:key="id" class="card" data-id="{{item.assignmentId}}" bindtap="notification">{{item.title}}</view></block></view>