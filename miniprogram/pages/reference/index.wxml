<view class="page"><view class="eyebrow">考吧167 / 复盘</view><view class="title">参考答案与评分标准</view><view class="subtitle">对照首轮评分依据，找到下一次作答的改进方向。</view><view wx:if="{{error}}" class="error" bindtap="load">{{error}}</view><block wx:if="{{reference}}"><view class="card"><view class="card-title">参考答案</view><text class="prose" user-select>{{reference.referenceAnswer || '老师尚未填写参考答案'}}</text></view><view class="card"><view class="card-title">评分标准 · {{reference.maxScore}} 分</view><text class="prose" user-select>{{reference.rubric}}</text></view><view wx:for="{{reference.scoringPoints}}" wx:key="index" class="annotation"><view class="card-title">{{item.label}} · {{item.points}} 分</view><view class="prose">{{item.description}}</view></view></block></view>