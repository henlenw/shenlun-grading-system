<view class="page"><view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view><block wx:if="{{assignment}}"><view class="eyebrow">{{assignment.question.category}} / {{assignment.question.type}}</view><view class="title">{{assignment.title}}</view><view class="subtitle">{{assignment.dueText}}</view><view class="training-rounds"><view wx:for="{{progress}}" wx:key="round" class="round-step {{item.done?'finished':''}}"><view>第 {{item.round}} 次</view><view>{{item.label}}</view></view></view><view wx:if="{{assignment.scores.length > 1}}" class="notice">从首轮到最近一轮，累计变化 {{assignment.improvement > 0 ? '+' : ''}}{{assignment.improvement}} 分。</view><view wx:if="{{!assignment.authorized}}" class="notice">作答权限已撤销，你仍可查看已提交的训练记录。</view><view wx:if="{{assignment.completed}}" class="notice">本题三次训练已完成。</view><view class="card"><view class="card-title">题目</view><view class="prose">{{assignment.question.prompt}}</view><view class="divider"></view><view class="card-title">作答要求</view><view class="prose">{{assignment.question.requirements}}</view><view class="notice">约 {{assignment.question.wordLimit}} 字 · 满分 {{assignment.question.maxScore}} 分</view></view><view class="card"><view class="card-title">给定材料</view><text class="prose" user-select>{{assignment.question.materials || '本题没有附加材料'}}</text></view><view wx:if="{{assignment.referenceUnlocked}}" class="card link" bindtap="reference">参考答案与评分标准已解锁 →</view><view wx:else class="notice">首次作答请独立完成。参考答案在首轮发布后按老师设置解锁。</view><view wx:if="{{attempts[0].revisionReason}}" class="notice"><view class="card-title">老师的重做要求</view>{{attempts[0].revisionReason}}<view class="prose">{{attempts[0].revisionRequirements}}</view>截止 {{attempts[0].revisionDueText}}</view><button wx:if="{{canWrite}}" bindtap="write">{{attempts[0].status==='DRAFT'?'继续写作':attempts.length?'开始下一轮训练':'首次独立作答'}}</button><view class="section">三轮作答记录</view><view wx:for="{{attempts}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="result"><view class="row"><text>第 {{item.roundNo}} 次作答</text><text class="badge">{{item.statusText}}</text></view><view class="muted">{{item.submittedText || '尚未提交'}}</view><view wx:if="{{item.finalGrade}}" class="link">{{item.finalGrade.finalScore}} 分 · 查看老师反馈 →</view></view></block></view>